# 复制为 config/project.env 后再填写；真实文件只保存在本机，不提交 Git。
# 格式为 KEY=value。值不会执行 shell 展开；路径必须填写绝对路径。
# 标有“秘密”的值不得发到聊天、写进命令行参数或日志。

# 高德服务

# 用途（可选）：供 Go API 在服务端查询地点、路线和天气，不会发送给浏览器。
# 获取/填写：在高德开放平台“应用管理”中新建 Key，服务平台选择“Web 服务”。
AMAP_WEBSERVICE_KEY=

# 用途（可选）：供浏览器加载高德地图 JS API；启用地图时必须和下一项成对配置。
# 获取/填写：在同一高德应用中新建 Key，服务平台选择“Web 端（JS API）”；可按实际入口配置白名单。
AMAP_JSAPI_KEY=

# 用途（可选、秘密）：与 JS API Key 配对，由 Go 代理注入高德请求，不能暴露给浏览器。
# 获取/填写：复制上述“Web 端（JS API）”Key 同时生成的 securityJsCode（安全密钥）。
AMAP_JSAPI_SECURITY_CODE=

# 应用地址与数据库

# 用途（必填）：应用的 URL 一级路径，同时决定 Web 构建路径和外部 API 前缀；不能含斜杠。
# 获取/填写：自行选择稳定的短名称，默认 travel；发布后不要随意修改。
APP_BASE_PATH=travel

# 用途（必填）：Web 映射到宿主机 127.0.0.1 的端口，不会直接监听公网。
# 获取/填写：选择本机或服务器未占用端口；默认 8501，可用 lsof 或 ss 检查占用。
APP_PORT=8501

# 用途（必填）：Go API 映射到宿主机 127.0.0.1 的端口，不会直接监听公网。
# 获取/填写：选择本机或服务器未占用且不同于 APP_PORT 的端口；默认 8502。
API_PORT=8502

# 用途（必填）：MongoDB 逻辑数据库名；应用、备份、恢复和契约检查必须使用同一个值。
# 获取/填写：首次部署时自行确定，默认 my_travel；已有数据时读取现有运行配置，不能随意改名。
MONGODB_DATABASE=my_travel

# 用途（必填）：控制登录 Cookie 是否只能经 HTTPS 发送；生产环境必须为 true。
# 获取/填写：本地回环 HTTP 调试填 false，HTTPS 部署填 true，不需要向外部平台申请。
COOKIE_SECURE=false

# 快照补偿

# 用途（可选）：后台扫描“数据库已提交但文件镜像待补偿”快照的时间间隔。
# 获取/填写：填写 Go duration（如 30s、1m）；通常保留 1m，根据恢复时效和负载调整。
SNAPSHOT_RECONCILE_INTERVAL=1m

# 用途（可选）：每轮快照补偿允许执行的最长时间，超时后等待下一轮重试。
# 获取/填写：填写正数 Go duration；通常保留 10s，并确保小于扫描间隔。
SNAPSHOT_RECONCILE_TIMEOUT=10s

# 用途（可选）：每轮最多补偿的快照数量，允许范围为 1～1000。
# 获取/填写：按待补偿量和磁盘能力选择；小规模部署通常保留 100。
SNAPSHOT_RECONCILE_BATCH=100

# API 运维脚本

# 用途（使用 travel-api 或成员初始化脚本时必填）：明确指定脚本唯一可操作的 API 根地址，不会从部署主机推断。
# 获取/填写：默认值直接连接本地 API；远程改为 https://真实域名/travel/api。
API_BASE_URL=http://127.0.0.1:8502

# 用途（可选）：是否让 API 运维脚本忽略无效或自签名 TLS 证书。
# 获取/填写：正常环境保持 false；仅在受控测试环境使用自签名证书时临时填 true。
API_INSECURE_TLS=false

# 用途（可选、个人资料）：作为 travel-api 创建首个或新增登录成员时的默认姓名，留空则交互输入。
# 获取/填写：填写该成员希望在应用中显示的真实姓名或称呼。
API_DISPLAY_NAME=

# 用途（可选、个人资料）：作为 travel-api 登录或创建成员时的默认 11 位手机号，留空则交互输入。
# 获取/填写：填写该成员实际用于登录的手机号；真实值只保存在本机受限配置中。
API_MOBILE=

# 用途（可选、秘密）：授权管理员新增登录成员；不配置时该管理入口不可用。
# 获取/填写：首次部署前在本机运行 openssl rand -hex 32，服务器与本机配置使用同一随机值。
ADMIN_PROVISION_TOKEN=

# 用途（空数据库必需、秘密）：只授权创建第一个管理员成员，已有管理员后不再承担日常登录功能。
# 获取/填写：可留空让 environment.sh 或本地 start.sh 自动生成，也可运行 openssl rand -hex 32 自行生成。
BOOTSTRAP_TOKEN=

# 用途（可选、含个人资料）：指定 deploy/users.sh 读取的成员初始化 JSON；留空使用 config/users.json。
# 获取/填写：复制 config/users.json.example 后填写并 chmod 600；如放在别处则填该文件的绝对路径。
USER_LIBRARY_FILE=

# 服务器发布（只在远程部署时填写）

# 用途（远程部署必填）：SSH 目标及域名可用前的 HTTPS 主机，也是远程发布地址的组成部分。
# 获取/填写：填写云服务器控制台分配的公网 IP，或已解析到该服务器的域名。
DEPLOY_HOST=

# 用途（可选）：执行 SSH、SCP 和服务器环境安装的系统账号。
# 获取/填写：使用云镜像提供或管理员创建的 SSH 账号；首次装依赖需要 root 权限，默认 root。
DEPLOY_USER=root

# 用途（可选）：服务器上保存项目 release、共享运行配置和恢复资料的根目录。
# 获取/填写：自行选择 /opt 或 /srv 下的绝对路径；默认 /opt/my-travel。
DEPLOY_DIR=/opt/my-travel

# 用途（必填）：Compose 项目名、镜像名前缀和服务器目录名，用来隔离同机多个项目。
# 获取/填写：自行选择稳定的小写名称，只能含小写字母、数字和连字符；默认 my-travel。
DEPLOY_PROJECT=my-travel

# 用途（可选）：本机为服务器构建镜像时采用的目标操作系统与 CPU 架构。
# 获取/填写：在服务器运行 uname -m；x86_64 填 linux/amd64，aarch64 或 arm64 填 linux/arm64。
DEPLOY_PLATFORM=linux/amd64

# 用途（可选、敏感路径）：指定 SSH 私钥；留空则使用 ssh-agent 和 SSH 默认配置。
# 获取/填写：填本机私钥绝对路径；可用 ssh-keygen -t ed25519 创建，并把对应公钥加入服务器 authorized_keys。
SSH_KEY=

# HTTPS 网关

# 用途（必填）：standalone 安装完整 Nginx HTTPS 入口；shared 只生成可并入现有网关的 location。
# 获取/填写：服务器没有现成 HTTPS 网关选 standalone；已有统一网关选 shared。
NGINX_MODE=standalone

# 用途（standalone 必填）：服务器上的 TLS 证书完整链文件，供 Nginx 建立 HTTPS。
# 获取/填写：使用证书服务商或 ACME 客户端生成后的服务器绝对路径。
TLS_CERTIFICATE_FULLCHAIN=

# 用途（standalone 必填、秘密）：与完整链匹配的 TLS 私钥文件；脚本只传路径，不应把内容复制到仓库。
# 获取/填写：使用同一次证书签发生成的服务器私钥绝对路径。
TLS_CERTIFICATE_PRIVATE_KEY=

# 构建与运行镜像

# 用途（可选）：MongoDB 运行和初始化镜像；摘要固定后可避免同一标签内容漂移。
# 获取/填写：通常保留仓库值；升级时先验证版本，再用 docker buildx imagetools inspect 查 sha256 摘要。
MONGO_IMAGE=m.daocloud.io/docker.io/library/mongo:8.0-noble@sha256:277f9152905bd1f32d3ece4526e0f90906dc238f7133b24ede8446ac9740b76d

# 用途（可选）：构建 React 静态资源的 Node.js 镜像，只在本机构建阶段使用。
# 获取/填写：通常保留仓库值；升级时用 docker buildx imagetools inspect 获取并固定目标平台摘要。
NODE_BUILD_IMAGE=m.daocloud.io/docker.io/library/node:24-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

# 用途（可选）：编译 Go API 和 Web 进程的构建镜像，不会作为最终运行镜像。
# 获取/填写：通常保留仓库值；升级时用 docker buildx imagetools inspect 获取并固定目标平台摘要。
GO_BUILD_IMAGE=m.daocloud.io/docker.io/library/golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651

# 用途（可选）：承载已编译 Go 程序的最小运行镜像，也用于初始化快照目录权限。
# 获取/填写：通常保留仓库值；升级时用 docker buildx imagetools inspect 获取并固定目标平台摘要。
RUNTIME_IMAGE=m.daocloud.io/docker.io/library/alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# 用途（可选）：Go 构建下载依赖时按顺序使用的模块代理，direct 表示代理失败后直连源码站点。
# 获取/填写：按构建机网络选择；中国大陆可用 https://goproxy.cn,direct，网络通畅时可用 https://proxy.golang.org,direct。
GO_MODULE_PROXY=https://goproxy.cn,direct
